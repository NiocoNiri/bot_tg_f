def calculate_quick_sum(contracts: int, instrument: Dict) -> Dict[str, float]:
    go_initial = float(instrument['go_initial'])
    margin = go_initial * contracts
    return {"margin": round(margin, 2)}

def calculate_futures(params: Dict, instrument: Dict) -> Dict[str, float]:
    direction = params['direction']
    entry = float(params['entry_price'])
    tp = float(params['tp'])
    sl = float(params['sl'])
    contracts = int(params['contracts'])
    account = float(params['account_size'])

    step_price = float(instrument['step_price'])
    step_cost = float(instrument['step_cost'])
    go_initial = float(instrument['go_initial'])

    if direction == 'long':
        tp_diff = max(0, tp - entry)
        sl_diff = max(0, entry - sl)
    else:
        tp_diff = max(0, entry - tp)
        sl_diff = max(0, sl - entry)

    steps_tp = tp_diff / step_price
    steps_sl = sl_diff / step_price

    profit = steps_tp * step_cost * contracts
    loss = steps_sl * step_cost * contracts
    rr = round(profit / loss, 2) if loss > 0 else float('inf')
    margin = go_initial * contracts

    return {
        "profit": round(profit, 2), "loss": round(loss, 2),
        "rr_ratio": rr, "margin": round(margin, 2),
        "risk_pct": round((loss / account) * 100, 2) if account > 0 else 0,
        "margin_pct": round((margin / account) * 100, 2) if account > 0 else 0,
        "steps_tp": round(steps_tp, 1), "steps_sl": round(steps_sl, 1)
    }

