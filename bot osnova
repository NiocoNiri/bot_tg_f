# ЗАПУСК
# ==============================================================================
def main():
    if not TOKEN:
        raise RuntimeError(
            "Не задан токен бота. Установите переменную окружения FUTURES_BOT_TOKEN."
        )

    # Для conversation_timeout и job_queue (периодическая синхронизация с МосБиржей)
    # вместе с persistent=True нужен:
    #   pip install "python-telegram-bot[job-queue]"
    persistence = PicklePersistence(filepath=PERSISTENCE_FILE)
    app = (
        ApplicationBuilder()
        .token(TOKEN)
        .persistence(persistence)
        .post_init(post_init)  # синхронизация с МосБиржей перед стартом polling
        .build()
    )

    if app.job_queue is not None:
        app.job_queue.run_repeating(
            moex_sync_job, interval=MOEX_SYNC_INTERVAL_SECONDS, first=MOEX_SYNC_INTERVAL_SECONDS
        )
    else:
        logger.warning(
            "job_queue недоступен — периодическая синхронизация с МосБиржей отключена. "
            "Установите пакет: pip install \"python-telegram-bot[job-queue]\""
        )

    conv_handler = ConversationHandler(
        entry_points=[
            CommandHandler("start", start),
            CallbackQueryHandler(restart_entry, pattern="^restart_calc$"),
        ],
        states={
            SELECTING_INSTRUMENT: [
                CallbackQueryHandler(search_mode, pattern="^search_mode$"),
                CallbackQueryHandler(instrument_selected, pattern="^inst_"),
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
                MessageHandler(filters.TEXT & ~filters.COMMAND, search_handler),
            ],
            ENTERING_CONTRACTS: [
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
                MessageHandler(filters.TEXT & ~filters.COMMAND, numeric_handler),
            ],
            AFTER_SUM: [
                CallbackQueryHandler(continue_full, pattern="^continue_full$"),
                CallbackQueryHandler(finish_quick, pattern="^finish_quick$"),
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
            ],
            CHOOSING_DIRECTION: [
                CallbackQueryHandler(direction_chosen, pattern="^dir_"),
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
            ],
            ENTERING_ENTRY_PRICE: [
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
                MessageHandler(filters.TEXT & ~filters.COMMAND, numeric_handler),
            ],
            ENTERING_TAKE_PROFIT: [
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
                MessageHandler(filters.TEXT & ~filters.COMMAND, numeric_handler),
            ],
            ENTERING_STOP_LOSS: [
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
                MessageHandler(filters.TEXT & ~filters.COMMAND, numeric_handler),
            ],
            ENTERING_ACCOUNT_SIZE: [
                CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
                MessageHandler(filters.TEXT & ~filters.COMMAND, numeric_handler),
            ],
        },
        fallbacks=[
            CommandHandler("cancel", cancel_calc),
            CommandHandler("start", start),
            CallbackQueryHandler(restart_entry, pattern="^restart_calc$"),
            CallbackQueryHandler(cancel_calc, pattern="^cancel_calc$"),
            CallbackQueryHandler(stale_callback_handler),
        ],
        per_message=False,
        conversation_timeout=1800,
        name="futures_calc_conv",
        persistent=True,
    )

    app.add_handler(CommandHandler("sync", manual_sync))
    app.add_handler(conv_handler)
    app.add_handler(CallbackQueryHandler(stale_callback_handler))

    app.add_error_handler(error_handler)

    logger.info("🚀 Бот запущен: данные по фьючерсам синхронизируются с МосБиржей (ISS API)!")
    app.run_polling(drop_pending_updates=True)

if __name__ == "__main__":
    main()