async def _render_instrument_list(message_target, context: ContextTypes.DEFAULT_TYPE, edit: bool):
    context.user_data.clear()
    df = await db.get_instruments_df()

    if df.empty:
        text = "⚠️ Список инструментов пуст. Попробуйте команду /sync или зайдите позже."
        if edit:
            await message_target.edit_message_text(text)
        else:
            await message_target.reply_text(text)
        return ConversationHandler.END

    context.user_data['calc_params'] = {}
    text = "Выберите инструмент:"
    markup = instruments_list_keyboard(df)
    if edit:
        await message_target.edit_message_text(text, reply_markup=markup)
    else:
        await message_target.reply_text(text, reply_markup=markup)
    return SELECTING_INSTRUMENT

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    return await _render_instrument_list(update.message, context, edit=False)

async def restart_entry(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
