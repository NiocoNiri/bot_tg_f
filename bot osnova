class Database:
    def __init__(self, db_path: str):
        self.db_path = db_path
        self._init_db()

    def _get_conn(self):
        return sqlite3.connect(self.db_path, check_same_thread=False)

    def _init_db(self):
        conn = self._get_conn()
        try:
            cursor = conn.cursor()
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS instruments (
                    ticker TEXT PRIMARY KEY, name TEXT, category TEXT,
                    step_price REAL, step_cost REAL, go_initial REAL, expiry_date TEXT,
                    volume REAL DEFAULT 0
                )
            """)
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS calc_history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, timestamp TEXT,
                    ticker TEXT, direction TEXT, contracts INTEGER, entry_price REAL,
                    tp_price REAL, sl_price REAL, account_size REAL,
                    profit_rub REAL, loss_rub REAL, risk_reward REAL, margin_used REAL
                )
            """)
            conn.commit()
        finally:
            conn.close()

    def seed_default_instruments(self):
        """Аварийный набор — гарантирует, что все инструменты из FEATURED_INSTRUMENTS
        присутствуют в таблице (с плейсхолдер-значениями), даже если в БД уже есть
        другие строки от прошлых запусков. INSERT OR IGNORE не трогает уже
        существующие (реальные, полученные с биржи) записи по этим тикерам."""
        conn = self._get_conn()
        try:
            cursor = conn.cursor()
            defaults = [
                (t, name, "featured", 1, 1, 1000, "", 0)
                for t, name in FEATURED_INSTRUMENTS
            ]
            cursor.executemany(
                "INSERT OR IGNORE INTO instruments VALUES (?,?,?,?,?,?,?,?)", defaults)
            conn.commit()
        finally:
            conn.close()

    def _upsert_instruments_sync(self, rows: List[Dict]):
        conn = self._get_conn()
        try:
            cursor = conn.cursor()
            cursor.executemany("""
                INSERT INTO instruments (ticker, name, category, step_price, step_cost, go_initial, expiry_date, volume)
                VALUES (:ticker, :name, :category, :step_price, :step_cost, :go_initial, :expiry_date, :volume)
                ON CONFLICT(ticker) DO UPDATE SET
                    name=excluded.name, category=excluded.category,
                    step_price=excluded.step_price, step_cost=excluded.step_cost,
                    go_initial=excluded.go_initial, expiry_date=excluded.expiry_date,
                    volume=excluded.volume
            """, rows)
            conn.commit()
        finally:
            conn.close()

    async def upsert_instruments(self, rows: List[Dict]):
        await asyncio.to_thread(self._upsert_instruments_sync, rows)

    def _save_calculation_sync(self, user_id: int, data: Dict, results: Dict):
        conn = self._get_conn()
        try:
            cursor = conn.cursor()
            cursor.execute("""
                INSERT INTO calc_history
                (user_id, timestamp, ticker, direction, contracts, entry_price,
                 tp_price, sl_price, account_size, profit_rub, loss_rub, risk_reward, margin_used)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (user_id, datetime.now().isoformat(), data['ticker'], data['direction'],
                  data['contracts'], data['entry_price'], data['tp'], data['sl'],
                  data['account_size'], results['profit'], results['loss'],
                  results['rr_ratio'], results['margin']))
            conn.commit()
        finally:
            conn.close()

    async def save_calculation(self, user_id: int, data: Dict, results: Dict):
        await asyncio.to_thread(self._save_calculation_sync, user_id, data, results)

    def _get_instruments_df_sync(self) -> pd.DataFrame:
        conn = self._get_conn()
        try:
            return pd.read_sql_query("SELECT * FROM instruments", conn)
        finally:
            conn.close()

    async def get_instruments_df(self) -> pd.DataFrame:
        return await asyncio.to_thread(self._get_instruments_df_sync)

