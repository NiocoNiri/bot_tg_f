def fetch_moex():
    """Сетевой запрос выполняется в отдельном потоке, не блокируя кнопки бота."""
    query = urlencode({
        "iss.meta": "off",
        "iss.only": "securities,marketdata",
        "securities.columns": (
            "SECID,SHORTNAME,SECNAME,MINSTEP,STEPPRICE,INITIALMARGIN,"
            "LASTTRADEDATE,ASSETCODE"
        ),
        "marketdata.columns": "SECID,LAST,VOLTODAY,OPENPOSITION",
    })
    request = Request(f"{MOEX_URL}?{query}", headers={"User-Agent": "futures-calc/1.0"})
    with urlopen(request, timeout=20) as response:
        return json.load(response)


def records(block):
    """Преобразовать таблицу ISS {columns: [], data: [[]]} в словари."""
    if not isinstance(block, dict):
        raise ValueError("Некорректная таблица ISS")
    columns, rows = block.get("columns"), block.get("data")
    if not isinstance(columns, list) or not isinstance(rows, list):
        raise ValueError("В ответе ISS отсутствуют columns/data")
    return (dict(zip(columns, row)) for row in rows if isinstance(row, list))


def positive(value):
    try:
        number = float(value)
        return number if math.isfinite(number) and number > 0 else 0.0
    except (ValueError, TypeError, OverflowError):
        return 0.0


def parse_moex(payload):
    if not isinstance(payload, dict):
        raise ValueError("Некорректный ответ ISS")
    securities = payload.get("securities")
    marketdata = payload.get("marketdata")
    required = {"SECID", "SHORTNAME", "MINSTEP", "STEPPRICE", "INITIALMARGIN"}
    if not isinstance(securities, dict) or not required.issubset(
        securities.get("columns") or []
    ):
        raise ValueError("ISS не вернул параметры контрактов")
    if not isinstance(marketdata, dict):
        raise ValueError("ISS не вернул рыночные данные")
    prices = {row.get("SECID"): row for row in records(marketdata)}
    wanted = dict(CONTRACTS)
    result = {}
    for row in records(securities):
        shortname = str(row.get("SHORTNAME") or "")
        ticker = next((t for t in wanted if t.casefold() == shortname.casefold()), None)
        if not ticker:
            continue
        step = positive(row.get("MINSTEP"))
        cost = positive(row.get("STEPPRICE"))
        margin = positive(row.get("INITIALMARGIN"))
        if not (step and cost and margin):
            continue
        market = prices.get(row.get("SECID"), {})
        result[ticker] = {
            "ticker": ticker,
            "name": wanted[ticker],
            "category": str(row.get("ASSETCODE") or "other"),
            "step_price": step,
            "step_cost": cost,
            "go_initial": margin,
            "expiry_date": str(row.get("LASTTRADEDATE") or ""),
            "volume": positive(market.get("VOLTODAY")),
            "open_interest": positive(market.get("OPENPOSITION")),
            "last_price": positive(market.get("LAST")),
        }
    return list(result.values())


async def sync_moex():
    try:
        rows = parse_moex(await asyncio.to_thread(fetch_moex))
        await asyncio.to_thread(db.save_instruments, rows)
        if len(rows) != len(CONTRACTS):
            missing = sorted(set(dict(CONTRACTS)) - {row["ticker"] for row in rows})
            log.warning("Не найдены на Мосбирже: %s", ", ".join(missing))
        log.info("Синхронизировано контрактов: %s/%s", len(rows), len(CONTRACTS))
        return len(rows)
    except Exception:
        log.exception("Не удалось обновить параметры Мосбиржи; сохранённые данные доступны")
        return 0


