async def search_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.user_data.get('search_mode'):
        df = await db.get_instruments_df()
        await update.message.reply_text(
            "Пожалуйста, выберите инструмент кнопками ниже, "
            "либо нажмите «🔍 Поиск по тикеру».",
            reply_markup=instruments_list_keyboard(df)
        )
        return SELECTING_INSTRUMENT

    term = update.message.text.strip().upper()
    df = await db.get_instruments_df()
    matches = df[df['ticker'].str.contains(term, case=False, na=False) |
                 df['name'].str.contains(term, case=False, na=False)]

    context.user_data['search_mode'] = False

    if matches.empty:
        context.user_data['search_mode'] = True
        await update.message.reply_text(f"❌ '{term}' не найден. Попробуйте снова:",
                                        reply_markup=cancel_keyboard())
        return SELECTING_INSTRUMENT

    await update.message.reply_text(
        f"Найдено {len(matches)}:",
        reply_markup=instruments_list_keyboard(matches)
    )
    return SELECTING_INSTRUMENT

async def instrument_selected(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    ticker = query.data.replace("inst_", "")
    df = await db.get_instruments_df()
    matches = df[df['ticker'] == ticker]
    if matches.empty:
        await query.edit_message_text("⚠️ Инструмент не найден. Выберите заново:",
                                      reply_markup=instruments_list_keyboard(df))
        return SELECTING_INSTRUMENT
    inst = matches.to_dict('records')[0]

    context.user_data.setdefault('calc_params', {})
    context.user_data['instrument'] = inst
    context.user_data['calc_params']['ticker'] = ticker
    context.user_data['next_step'] = 'contracts'

    expiry_line = f"Экспирация: {inst['expiry_date']}" if inst.get('expiry_date') else "Экспирация: нет данных"
    await query.edit_message_text(
        f"📌 *{ticker}* ({inst['name']})\n"
        f"Шаг: {inst['step_price']} | Стоимость шага: {inst['step_cost']}₽\n"
        f"ГО: {inst['go_initial']}₽ | {expiry_line}\n\n"
        f"➡️ Введите количество контрактов:",
        parse_mode="Markdown", reply_markup=cancel_keyboard()
    )
    return ENTERING_CONTRACTS

