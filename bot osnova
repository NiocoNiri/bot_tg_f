                "Для остальных доступны прежние данные, если они были получены ранее.")
    else:
        text = "⚠️ Нет обновлений с биржи. Сохранённые данные доступны, если были получены ранее."
    await message.edit_text(text)


async def on_error(update, context):
    log.error("Ошибка обработки сообщения", exc_info=(
        type(context.error), context.error, context.error.__traceback__
    ))
    if isinstance(update, Update):
        try:
            if update.callback_query:
                await update.callback_query.answer()
            if update.effective_message:
                await update.effective_message.reply_text(
                    "⚠️ Ошибка обработки. Начните новый расчёт: /start"
                )
        except Exception:
            log.exception("Не удалось сообщить об ошибке пользователю")


def main():
    if not TOKEN or TOKEN == "__EXISTING_TOKEN__":
        raise RuntimeError("Укажите токен в FUTURES_BOT_TOKEN")
    app = (
        ApplicationBuilder()
        .token(TOKEN)
        .persistence(PicklePersistence(filepath=STATE_FILE))
        .post_init(post_init)
        .connect_timeout(20)
        .get_updates_connect_timeout(20)
        .build()
    )
    if app.job_queue is None:
        raise RuntimeError('Установите: python -m pip install "python-telegram-bot[job-queue]>=22,<23"')
    app.job_queue.run_repeating(sync_job, interval=SYNC_INTERVAL, first=SYNC_INTERVAL)

    conversation = ConversationHandler(
        entry_points=[CommandHandler("start", show_list),
                      CallbackQueryHandler(show_list, pattern=r"^restart_calc$")],
        states={
            SELECT: [CallbackQueryHandler(search_mode, pattern=r"^search_mode$"),
                     CallbackQueryHandler(selected, pattern=r"^inst_"),
                     CallbackQueryHandler(cancel, pattern=r"^cancel_calc$"),
                     MessageHandler(filters.TEXT & ~filters.COMMAND, search_text)],
            CONTRACT_COUNT: [CallbackQueryHandler(cancel, pattern=r"^cancel_calc$"),
                             MessageHandler(filters.TEXT & ~filters.COMMAND, numeric)],
            AFTER_SUM: [CallbackQueryHandler(continue_full, pattern=r"^continue_full$"),
                        CallbackQueryHandler(finish_quick, pattern=r"^finish_quick$"),
                        CallbackQueryHandler(cancel, pattern=r"^cancel_calc$")],
            DIRECTION: [CallbackQueryHandler(direction_chosen, pattern=r"^dir_(long|short)$"),
                        CallbackQueryHandler(cancel, pattern=r"^cancel_calc$")],
            ENTRY: [CallbackQueryHandler(cancel, pattern=r"^cancel_calc$"),
                    MessageHandler(filters.TEXT & ~filters.COMMAND, numeric)],
            TAKE_PROFIT: [CallbackQueryHandler(cancel, pattern=r"^cancel_calc$"),
                          MessageHandler(filters.TEXT & ~filters.COMMAND, numeric)],
            STOP_LOSS: [CallbackQueryHandler(cancel, pattern=r"^cancel_calc$"),
                        MessageHandler(filters.TEXT & ~filters.COMMAND, numeric)],
        },
        fallbacks=[CommandHandler("start", show_list), CommandHandler("cancel", cancel),
                   CallbackQueryHandler(cancel, pattern=r"^cancel_calc$"),
                   CallbackQueryHandler(stale_button)],
        allow_reentry=True,
        conversation_timeout=1800,
        name="futures_calc_conv",  # прежнее имя сохраняет состояния после перезапуска
        persistent=True,
    )
    app.add_handler(CommandHandler("sync", manual_sync))
    app.add_handler(conversation)
    app.add_handler(CallbackQueryHandler(stale_button))
    app.add_error_handler(on_error)
    log.info("Подключаюсь к Telegram API (готовность будет указана отдельно)")
    # Явно подписываемся на сообщения И на нажатия inline-кнопок.
    # Без allowed_updates Telegram сохраняет прежний фильтр этого токена:
    # /start может приходить, а callback_query — отсутствовать полностью.
    app.run_polling(
        allowed_updates=["message", "callback_query"],
        bootstrap_retries=-1,
        drop_pending_updates=False,
    )


if __name__ == "__main__":
    main()
