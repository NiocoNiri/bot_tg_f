    )
    return ENTERING_ENTRY_PRICE

async def numeric_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if 'instrument' not in context.user_data or 'calc_params' not in context.user_data:
        await update.message.reply_text("⚠️ Сессия истекла. Начните с /start")
        return ConversationHandler.END

    next_step = context.user_data.get('next_step', 'contracts')
    current_state = STATE_BY_STEP.get(next_step, ENTERING_CONTRACTS)

    text = update.message.text.strip().replace(",", ".")
    try:
        value = float(text)
        if not math.isfinite(value):
            raise ValueError("non-finite value")
        if value <= 0:
            raise ValueError("non-positive value")
    except (ValueError, OverflowError):
        await update.message.reply_text("⚠️ Введите корректное положительное число:",
                                        reply_markup=cancel_keyboard())
        return current_state

    params = context.user_data['calc_params']

    if next_step == 'contracts':
        if not value.is_integer():
            await update.message.reply_text(
                "⚠️ Количество контрактов должно быть целым числом (например, 1, 2, 5):",
                reply_markup=cancel_keyboard())
            return current_state
        contracts = int(value)
        params['contracts'] = contracts

        instrument = context.user_data['instrument']
        try:
            quick = calculate_quick_sum(contracts, instrument)
        except Exception:
            logger.exception("Ошибка при расчёте суммы позиции")
            await update.message.reply_text(
                "⚠️ Не удалось посчитать сумму позиции. Попробуйте начать заново: /start")
            context.user_data.clear()
            return ConversationHandler.END

        result_text = (
            f"📌 *{params['ticker']}*\n"
            f"Количество: {contracts} контр.\n"
            f"━━━━━━━━━━━━━━━━━━━━\n"
            f"🏦 *Сумма позиции (ГО):* {quick['margin']:,.0f} ₽\n"
            f"━━━━━━━━━━━━━━━━━━━━"
        )
        await update.message.reply_text(result_text, parse_mode="Markdown", reply_markup=after_sum_keyboard())
        return AFTER_SUM

    elif next_step == 'entry_price':
        params['entry_price'] = value
        context.user_data['next_step'] = 'tp'
        await update.message.reply_text("➡️ Цель (Take-Profit):", reply_markup=cancel_keyboard())
        return ENTERING_TAKE_PROFIT

    elif next_step == 'tp':
        direction = params.get('direction')
        entry = params.get('entry_price')
        if direction == 'long' and value <= entry:
            await update.message.reply_text(
                f"⚠️ Для LONG цель (TP) должна быть выше цены входа ({entry}). Введите заново:",
                reply_markup=cancel_keyboard())
            return current_state
        if direction == 'short' and value >= entry:
            await update.message.reply_text(
                f"⚠️ Для SHORT цель (TP) должна быть ниже цены входа ({entry}). Введите заново:",
                reply_markup=cancel_keyboard())
            return current_state
        params['tp'] = value
        context.user_data['next_step'] = 'sl'
        await update.message.reply_text("➡️ Стоп-лосс (Stop-Loss):", reply_markup=cancel_keyboard())
        return ENTERING_STOP_LOSS

    elif next_step == 'sl':
        direction = params.get('direction')
        entry = params.get('entry_price')
        if direction == 'long' and value >= entry:
            await update.message.reply_text(
                f"⚠️ Для LONG стоп-лосс должен быть ниже цены входа ({entry}). Введите заново:",
                reply_markup=cancel_keyboard())
            return current_state
        if direction == 'short' and value <= entry:
            await update.message.reply_text(
                f"⚠️ Для SHORT стоп-лосс должен быть выше цены входа ({entry}). Введите заново:",
                reply_markup=cancel_keyboard())
            return current_state
        params['sl'] = value
        context.user_data['next_step'] = 'account_size'
        await update.message.reply_text("➡️ Размер счета (депозит) в ₽:", reply_markup=cancel_keyboard())
        return ENTERING_ACCOUNT_SIZE

    elif next_step == 'account_size':
        params['account_size'] = value
        try:
            results = calculate_futures(params, context.user_data['instrument'])
            await db.save_calculation(update.effective_user.id, params, results)
        except Exception:
            logger.exception("Ошибка при расчёте/сохранении")
            await update.message.reply_text(
                "⚠️ Произошла ошибка при расчёте. Попробуйте начать заново: /start")
            context.user_data.clear()
            return ConversationHandler.END

        dir_label = "LONG 🟢" if params['direction'] == 'long' else "SHORT 🔴"
        result_text = (
            f"✅ *РАСЧЕТ ГОТОВ*\n━━━━━━━━━━━━━━━━━━━━\n"
            f"📌 {params['ticker']} | {dir_label} | {int(params['contracts'])} контр.\n"
            f"Вход: {params['entry_price']} → TP: {params['tp']} / SL: {params['sl']}\n\n"
            f"💰 *Прибыль:* {results['profit']:,.0f} ₽ ({results['steps_tp']} шагов)\n"
            f"📉 *Убыток:* {results['loss']:,.0f} ₽ ({results['steps_sl']} шагов)\n"
            f"⚖️ *Risk/Reward:* 1 : {results['rr_ratio']}\n\n"
            f"🏦 *Маржа (ГО):* {results['margin']:,.0f} ₽ ({results['margin_pct']}%)\n"
            f"⚠️ *Риск:* {results['risk_pct']}% от счета\n━━━━━━━━━━━━━━━━━━━━"
        )

        context.user_data.clear()

        await update.message.reply_text(result_text, parse_mode="Markdown",
                                        reply_markup=restart_keyboard())
        return ConversationHandler.END

    context.user_data.clear()
    await update.message.reply_text("⚠️ Что-то пошло не так. Начните заново: /start")
    return ConversationHandler.END

async def cancel_calc(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    context.user_data.clear()
    await query.edit_message_text("❌ Расчет отменен.", reply_markup=restart_keyboard())
    return ConversationHandler.END

async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    logger.error(f"Exception: {context.error}", exc_info=context.error)
    try:
        if isinstance(update, Update) and update.effective_message:
            await update.effective_message.reply_text(
                "⚠️ Произошла непредвиденная ошибка. Попробуйте /start."
            )
    except Exception:
        pass

