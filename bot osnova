def quick_calculation(instrument, count):
    margin_per_contract = decimal_number(instrument["go_initial"])
    oi = decimal_number(positive(instrument.get("open_interest")))
    last = decimal_number(positive(instrument.get("last_price")))
    multiplier = decimal_number(instrument["step_cost"]) / decimal_number(instrument["step_price"])
    return {
        "margin": rounded(margin_per_contract * count),
        "oi": float(oi),
        "oi_value": rounded(oi * margin_per_contract),
        "last": float(last),
        "position": rounded(last * multiplier * count),
    }


def full_calculation(params, instrument):
    entry, tp, sl = (decimal_number(params[key]) for key in ("entry_price", "tp", "sl"))
    count = params["contracts"]
    step = decimal_number(instrument["step_price"])
    step_cost = decimal_number(instrument["step_cost"])
    zero = Decimal("0")
    if params["direction"] == "long":
        profit_steps = max(zero, tp - entry) / step
        loss_steps = max(zero, entry - sl) / step
    else:
        profit_steps = max(zero, entry - tp) / step
        loss_steps = max(zero, sl - entry) / step
    profit = profit_steps * step_cost * count
    loss = loss_steps * step_cost * count
    margin = decimal_number(instrument["go_initial"]) * count
    return {
        "profit": rounded(profit), "loss": rounded(loss), "margin": rounded(margin),
        "steps_tp": rounded(profit_steps, 1), "steps_sl": rounded(loss_steps, 1),
        "rr_ratio": rounded(profit / loss) if loss else float("inf"),
        "risk_pct": rounded(loss / margin * 100),
    }


async def numeric(update, context):
    data = context.user_data
    if "instrument" not in data or "calc_params" not in data:
        await update.message.reply_text("Сессия истекла. Начните с /start")
        return ConversationHandler.END
    step = data.get("next_step")
    state = {"contracts": CONTRACT_COUNT, "entry": ENTRY, "tp": TAKE_PROFIT,
             "sl": STOP_LOSS}.get(step)
    if state is None:
        await update.message.reply_text("Сессия истекла. Начните с /start")
        return ConversationHandler.END
    try:
        value = float(update.message.text.strip().replace(",", "."))
        if not math.isfinite(value) or value <= 0:
            raise ValueError
    except (ValueError, OverflowError):
        await update.message.reply_text(
            "⚠️ Введите положительное число:", reply_markup=cancel_keyboard()
        )
        return state

    params = data["calc_params"]
    if step == "contracts":
        if not value.is_integer():
            await update.message.reply_text(
                "⚠️ Количество контрактов должно быть целым числом:",
                reply_markup=cancel_keyboard(),
            )
            return state
        params["contracts"] = int(value)
        result = quick_calculation(data["instrument"], int(value))
        data["quick_margin"] = result["margin"]
        oi_line = (f"📊 Сумма позиций (откр. интерес): {rub(result['oi_value'])} ₽ "
                   f"(OI: {rub(result['oi'])} контр.)" if result["oi"]
                   else "📊 Сумма позиций (откр. интерес): нет данных")
        size_line = (f"📐 Размер позиции (по тек. цене {result['last']:g}): "
                     f"{rub(result['position'])} ₽" if result["last"]
                     else "📐 Размер позиции (по тек. цене): нет данных")
        await update.message.reply_text(
            f"📌 {params['ticker']}\nКоличество: {int(value)} контр.\n"
            f"🏦 Сумма позиции (ГО): {rub(result['margin'])} ₽\n"
            f"{oi_line}\n{size_line}", reply_markup=sum_keyboard(),
        )
        return AFTER_SUM
    if step == "entry":
        params["entry_price"] = value
        data["next_step"] = "tp"
        await update.message.reply_text("➡️ Цель (Take-Profit):", reply_markup=cancel_keyboard())
        return TAKE_PROFIT

    direction, entry = params["direction"], params["entry_price"]
    if step == "tp":
        if (direction == "long" and value <= entry) or (direction == "short" and value >= entry):
            relation = "выше" if direction == "long" else "ниже"
            await update.message.reply_text(
                f"⚠️ TP должен быть {relation} цены входа ({entry}). Введите заново:",
                reply_markup=cancel_keyboard(),
            )
            return TAKE_PROFIT
        params["tp"] = value
        data["next_step"] = "sl"
        await update.message.reply_text("➡️ Стоп-лосс (Stop-Loss):", reply_markup=cancel_keyboard())
        return STOP_LOSS

    if (direction == "long" and value >= entry) or (direction == "short" and value <= entry):
        relation = "ниже" if direction == "long" else "выше"
        await update.message.reply_text(
            f"⚠️ SL должен быть {relation} цены входа ({entry}). Введите заново:",
            reply_markup=cancel_keyboard(),
        )
        return STOP_LOSS
    params["sl"] = value
    params["account_size"] = data["quick_margin"]
    result = full_calculation(params, data["instrument"])
    await asyncio.to_thread(db.save_calculation, update.effective_user.id, params, result)
    label = "LONG 🟢" if direction == "long" else "SHORT 🔴"
    await update.message.reply_text(
        f"✅ РАСЧЕТ ГОТОВ\n📌 {params['ticker']} | {label} | {params['contracts']} контр.\n"
        f"Вход: {entry} → TP: {params['tp']} / SL: {value}\n\n"
        f"💰 Прибыль: {rub(result['profit'])} ₽ ({result['steps_tp']} шагов)\n"
        f"📉 Убыток: {rub(result['loss'])} ₽ ({result['steps_sl']} шагов)\n"
        f"⚖️ Risk/Reward: 1 : {result['rr_ratio']}\n\n"
        f"🏦 Маржа (ГО): {rub(result['margin'])} ₽\n"
        f"⚠️ Риск при срабатывании SL: {result['risk_pct']}% от суммы ГО по этой позиции",
        reply_markup=restart_keyboard(),
    )
    data.clear()
    return ConversationHandler.END


