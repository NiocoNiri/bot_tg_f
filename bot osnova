def _fetch_moex_forts_sync() -> dict:
    """Синхронный HTTP-запрос ко всему рынку FORTS одним вызовом.
    Выполняется через asyncio.to_thread, чтобы не блокировать event loop бота."""
    params = {
        "iss.meta": "off",
        "iss.only": "securities,marketdata",
        "securities.columns": "SECID,SHORTNAME,SECNAME,MINSTEP,STEPPRICE,INITIALMARGIN,LASTTRADEDATE,ASSETCODE",
        "marketdata.columns": "SECID,LAST,VOLTODAY",
    }
    resp = requests.get(MOEX_FORTS_URL, params=params, timeout=20)
    resp.raise_for_status()
    return resp.json()

def _parse_moex_response(payload: dict, allow_expired: bool = False) -> List[Dict]:
    """Разбирает ответ ISS в список словарей {ticker(SECID), name(SHORTNAME), ...},
    готовых для записи в таблицу instruments."""
    sec_block = payload.get("securities", {}) or {}
    sec_cols = sec_block.get("columns", []) or []
    sec_rows = sec_block.get("data", []) or []

    md_block = payload.get("marketdata", {}) or {}
    md_cols = md_block.get("columns", []) or []
    md_rows = md_block.get("data", []) or []

    def col_index(cols, name):
        return cols.index(name) if name in cols else None

    required = ["SECID", "SHORTNAME", "MINSTEP", "STEPPRICE", "INITIALMARGIN", "LASTTRADEDATE", "ASSETCODE"]
    idx = {name: col_index(sec_cols, name) for name in required}
    if any(idx[name] is None for name in ["SECID", "MINSTEP", "STEPPRICE", "INITIALMARGIN"]):
        raise ValueError("Неожиданный формат ответа ISS МосБиржи (нет нужных колонок)")

    volume_by_secid = {}
    md_secid_idx = col_index(md_cols, "SECID")
    md_vol_idx = col_index(md_cols, "VOLTODAY")
    if md_secid_idx is not None and md_vol_idx is not None:
        for row in md_rows:
            try:
                secid = row[md_secid_idx]
                vol = row[md_vol_idx] or 0
                volume_by_secid[secid] = float(vol)
            except (IndexError, TypeError, ValueError):
                continue

    today = date.today().isoformat()
    results = []
    for row in sec_rows:
        try:
            secid = row[idx["SECID"]]
            shortname = row[idx["SHORTNAME"]] or secid
            min_step = row[idx["MINSTEP"]]
            step_cost = row[idx["STEPPRICE"]]
            go_initial = row[idx["INITIALMARGIN"]]
            expiry = row[idx["LASTTRADEDATE"]] or ""
            asset_code = row[idx["ASSETCODE"]] if idx["ASSETCODE"] is not None else ""
        except (IndexError, TypeError):
            continue

        if not min_step or not step_cost or not go_initial:
            continue
        try:
            min_step = float(min_step)
            step_cost = float(step_cost)
            go_initial = float(go_initial)
        except (TypeError, ValueError):
            continue
        if min_step <= 0 or step_cost <= 0 or go_initial <= 0:
            continue
        if not allow_expired and expiry and expiry < today:
            continue

        results.append({
            "ticker": secid,
            "name": shortname,
            "category": asset_code or "other",
            "step_price": min_step,
            "step_cost": step_cost,
            "go_initial": go_initial,
            "expiry_date": expiry,
            "volume": volume_by_secid.get(secid, 0.0),
        })
    return results

async def sync_moex_instruments() -> int:
    """Загружает весь рынок FORTS одним запросом, затем отбирает только тикеры
    из FEATURED_INSTRUMENTS — сопоставление идёт по точному совпадению
    человекочитаемого кода (SHORTNAME биржи) без учёта регистра.
    Отображаемое название переопределяется на заданное пользователем."""
    try:
        payload = await asyncio.to_thread(_fetch_moex_forts_sync)
    except Exception:
        logger.exception("МосБиржа: не удалось получить данные (сеть/HTTP)")
        return 0

    try:
        # allow_expired=True: список инструментов задан явно, не отбрасываем их
        # только из-за близкой/прошедшей даты экспирации.
        all_rows = _parse_moex_response(payload, allow_expired=True)
    except Exception:
        logger.exception("МосБиржа: не удалось разобрать ответ ISS")
        return 0

    by_shortname = {r["name"].upper(): r for r in all_rows if r.get("name")}

    matched: List[Dict] = []
    for human_ticker, display_name in FEATURED_INSTRUMENTS:
        row = by_shortname.get(human_ticker.upper())
        if row is None:
            logger.warning(f"МосБиржа: тикер '{human_ticker}' не найден среди инструментов FORTS "
                            f"(проверьте точное написание кода на moex.com)")
            continue
        row = dict(row)
        row["ticker"] = human_ticker  # используем ваш код как первичный ключ в нашей БД
        row["name"] = display_name    # и ваше название для отображения
        matched.append(row)

    if not matched:
        logger.warning("МосБиржа: ни один из отслеживаемых тикеров не найден в выгрузке")
        return 0

    await db.upsert_instruments(matched)
    return len(matched)

async def moex_sync_job(context: ContextTypes.DEFAULT_TYPE):
    """Периодическая фоновая синхронизация (job_queue)."""
    count = await sync_moex_instruments()
    logger.info(f"МосБиржа: периодическая синхронизация — {count} из {len(FEATURED_INSTRUMENTS)} инструментов")

async def post_init(app):
    """Синхронизация с МосБиржей сразу при старте бота, до начала polling.
    После синхронизации (даже частично успешной) добиваем плейсхолдерами любые
    тикеры, которые не удалось найти/загрузить — чтобы кнопка на них всегда
    была видна, а не пропадала молча."""
    count = await sync_moex_instruments()
    await asyncio.to_thread(db.seed_default_instruments)
    if count < len(FEATURED_INSTRUMENTS):
        logger.warning(
            f"МосБиржа: загружено {count} из {len(FEATURED_INSTRUMENTS)} инструментов при старте; "
            f"остальные показаны с плейсхолдер-значениями до следующей успешной синхронизации."
        )
    else:
        logger.info(f"МосБиржа: успешно загружены все {count} инструментов при старте.")

