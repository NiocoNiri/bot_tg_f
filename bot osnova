def rub(number):
    whole = decimal_number(number).quantize(Decimal("1"), rounding=ROUND_HALF_UP)
    return f"{whole:,.0f}".replace(",", " ")


def decimal_number(value):
    """Точное десятичное представление для вычислений денежных сумм."""
    return Decimal(str(value))


def rounded(value, places=2):
    """Округляем только окончательный результат; 0.005 → 0.01."""
    unit = Decimal("1").scaleb(-places)
    return float(value.quantize(unit, rounding=ROUND_HALF_UP))


class Database:
    def __init__(self, filename):
        self.filename = filename
        with self.connect() as conn:
            conn.execute("""
                CREATE TABLE IF NOT EXISTS instruments (
                    ticker TEXT PRIMARY KEY, name TEXT, category TEXT,
                    step_price REAL, step_cost REAL, go_initial REAL,
                    expiry_date TEXT, volume REAL DEFAULT 0,
                    open_interest REAL DEFAULT 0, last_price REAL DEFAULT 0
                )
            """)
            conn.execute("""
                CREATE TABLE IF NOT EXISTS calc_history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER,
                    timestamp TEXT, ticker TEXT, direction TEXT, contracts INTEGER,
                    entry_price REAL, tp_price REAL, sl_price REAL, account_size REAL,
                    profit_rub REAL, loss_rub REAL, risk_reward REAL, margin_used REAL
                )
            """)
            columns = {row[1] for row in conn.execute("PRAGMA table_info(instruments)")}
            for column in ("open_interest", "last_price"):
                if column not in columns:
                    conn.execute(
                        f"ALTER TABLE instruments ADD COLUMN {column} REAL DEFAULT 0"
                    )
            # Нулевые значения служат признаком отсутствия биржевых параметров.
            conn.executemany("""
                INSERT OR IGNORE INTO instruments
                (ticker, name, category, step_price, step_cost, go_initial,
                 expiry_date, volume, open_interest, last_price)
                VALUES (?, ?, 'featured', 0, 0, 0, '', 0, 0, 0)
            """, CONTRACTS)

    @contextmanager
    def connect(self):
        conn = sqlite3.connect(self.filename, timeout=30)
        conn.row_factory = sqlite3.Row
        try:
            with conn:
                yield conn
        finally:
            conn.close()

    def instruments(self):
        with self.connect() as conn:
            return {row["ticker"]: dict(row) for row in conn.execute(
                "SELECT * FROM instruments"
            )}

    def get(self, ticker):
        with self.connect() as conn:
            row = conn.execute(
                "SELECT * FROM instruments WHERE ticker = ?", (ticker,)
            ).fetchone()
        return dict(row) if row else None

    def save_instruments(self, instruments):
        if not instruments:
            return
        with self.connect() as conn:
            conn.executemany("""
                INSERT INTO instruments
                (ticker, name, category, step_price, step_cost, go_initial,
                 expiry_date, volume, open_interest, last_price)
                VALUES (:ticker, :name, :category, :step_price, :step_cost,
                        :go_initial, :expiry_date, :volume, :open_interest, :last_price)
                ON CONFLICT(ticker) DO UPDATE SET
                    name = excluded.name, category = excluded.category,
                    step_price = excluded.step_price, step_cost = excluded.step_cost,
                    go_initial = excluded.go_initial, expiry_date = excluded.expiry_date,
                    volume = excluded.volume, open_interest = excluded.open_interest,
                    last_price = excluded.last_price
            """, instruments)

    def save_calculation(self, user_id, params, result):
        with self.connect() as conn:
            conn.execute("""
                INSERT INTO calc_history
                (user_id, timestamp, ticker, direction, contracts, entry_price,
                 tp_price, sl_price, account_size, profit_rub, loss_rub,
                 risk_reward, margin_used)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                user_id, datetime.now().isoformat(), params["ticker"],
                params["direction"], params["contracts"], params["entry_price"],
                params["tp"], params["sl"], params["account_size"],
                result["profit"], result["loss"], result["rr_ratio"],
                result["margin"],
            ))


